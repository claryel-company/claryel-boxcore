{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://boxcore.claryel.space/schemas/change-plan.schema.json",
  "title": "CLARYEL Box Core change plan",
  "description": "A constrained, explainable proposal generated from local administrative intent. It is data for review and policy evaluation, not direct execution authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "planId",
    "createdAt",
    "request",
    "system",
    "baseRevision",
    "summary",
    "changes",
    "preconditions",
    "validation",
    "rollback",
    "approval"
  ],
  "properties": {
    "schemaVersion": {
      "const": "0.1"
    },
    "planId": {
      "type": "string",
      "pattern": "^plan-[a-z0-9][a-z0-9-]{5,63}$"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["channel", "intent", "locale", "synthetic"],
      "properties": {
        "channel": {
          "type": "string",
          "enum": ["voice", "text", "api", "local-cli"]
        },
        "intent": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "locale": {
          "type": "string",
          "pattern": "^[A-Za-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
        },
        "synthetic": {
          "type": "boolean"
        }
      }
    },
    "system": {
      "type": "object",
      "additionalProperties": false,
      "required": ["systemId", "approvalMode", "declaredCapabilities"],
      "properties": {
        "systemId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{1,62}$"
        },
        "approvalMode": {
          "type": "string",
          "enum": ["automatic-low-risk", "always-human", "offline-manual"]
        },
        "declaredCapabilities": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9.-]{1,127}$"
          },
          "uniqueItems": true
        }
      }
    },
    "baseRevision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40,64}$"
    },
    "proposedRevision": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{40,64}$"
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "changes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "$ref": "#/$defs/change"
      }
    },
    "preconditions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/check"
      },
      "minItems": 1,
      "maxItems": 50
    },
    "validation": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/check"
      },
      "minItems": 1,
      "maxItems": 100
    },
    "rollback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generation", "automaticOnHealthFailure", "mutableStateRecoveryRequired"],
      "properties": {
        "generation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "automaticOnHealthFailure": {
          "const": true
        },
        "mutableStateRecoveryRequired": {
          "type": "boolean"
        },
        "recoveryContract": {
          "type": ["string", "null"],
          "pattern": "^[a-z0-9][a-z0-9./_-]{1,199}$"
        }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["humanApproved", "approvedBy", "approvedAt"],
      "properties": {
        "humanApproved": {
          "type": "boolean"
        },
        "approvedBy": {
          "type": ["string", "null"],
          "maxLength": 160
        },
        "approvedAt": {
          "type": ["string", "null"],
          "format": "date-time"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "humanApproved": {"const": true}
            },
            "required": ["humanApproved"]
          },
          "then": {
            "properties": {
              "approvedBy": {"type": "string", "minLength": 1},
              "approvedAt": {"type": "string", "format": "date-time"}
            }
          }
        }
      ]
    }
  },
  "$defs": {
    "change": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "action", "before", "after", "containsSecretValue", "containsCustomerData"],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^/(services|deployment|remoteAccess|profile|metadata)(/[A-Za-z0-9._-]+)*$"
        },
        "action": {
          "type": "string",
          "enum": [
            "enable-metrics",
            "change-dashboard-layout",
            "change-log-retention",
            "install-service",
            "remove-service",
            "change-memory-limit",
            "change-update-channel",
            "expose-public-service",
            "enable-intel-amt",
            "enable-redfish",
            "enable-ipmi",
            "repartition-disk",
            "delete-backup",
            "rotate-root-key",
            "wipe-data",
            "run-shell",
            "modify-policy",
            "disable-approval",
            "disable-audit",
            "disable-rollback"
          ]
        },
        "before": {},
        "after": {},
        "containsSecretValue": {
          "const": false
        },
        "containsCustomerData": {
          "const": false
        },
        "requiredCapability": {
          "type": ["string", "null"],
          "pattern": "^[a-z0-9][a-z0-9.-]{1,127}$"
        }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description", "required"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9.-]{1,127}$"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "required": {
          "const": true
        }
      }
    }
  }
}
